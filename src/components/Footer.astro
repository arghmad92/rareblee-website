      <div class="footer-bottom-center">
        <div class="visitor-counter">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" opacity="0.5"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
          <span id="visitorCount">—</span> visitors
        </div>
        <p class="footer-ssm">SSM: 202303207070 (MA0305189-M)</p>
      </div>
      <p class="footer-tagline">Glow Different.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--green);
    padding: 80px 0 32px;
    color: var(--white);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    gap: 40px;
    margin-bottom: 56px;
  }

  .footer-logo {
    width: 80px;
    height: auto;
    margin-bottom: 16px;
  }

  .footer-brand p {
    font-size: 0.85rem;
    opacity: 0.5;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-links a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(245, 198, 208, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pink);
    transition: all 0.3s var(--ease-out-expo);
  }

  .social-links a:hover {
    background: var(--pink);
    color: var(--green);
    border-color: var(--pink);
    transform: translateY(-2px);
  }

  .footer-links h4 {
    font-family: 'Roca', sans-serif;
    font-size: 0.95rem;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-links a {
    font-size: 0.85rem;
    opacity: 0.5;
    transition: all 0.3s;
    position: relative;
    display: inline-block;
  }

  .footer-links a:hover {
    opacity: 1;
    color: var(--pink);
    transform: translateX(4px);
  }

  .footer-newsletter h4 {
    font-family: 'Roca', sans-serif;
    font-size: 0.95rem;
    color: var(--white);
    margin-bottom: 12px;
  }

  .footer-newsletter p {
    font-size: 0.82rem;
    opacity: 0.5;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .newsletter-form {
    display: flex;
    gap: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    padding: 4px;
    transition: border-color 0.3s;
  }

  .newsletter-form:focus-within {
    border-color: var(--pink);
  }

  .newsletter-form input {
    flex: 1;
    background: none;
    border: none;
    padding: 10px 16px;
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    outline: none;
    min-width: 0;
  }

  .newsletter-form input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .newsletter-form button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--pink);
    color: var(--green);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s var(--ease-out-expo);
    flex-shrink: 0;
  }

  .newsletter-form button:hover {
    transform: scale(1.1);
    background: var(--white);
  }

  .newsletter-msg {
    font-size: 0.78rem;
    margin-top: 10px;
    opacity: 0;
    transition: opacity 0.3s;
    color: var(--pink);
  }

  .newsletter-msg.show {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    font-size: 0.78rem;
    opacity: 0.35;
  }

  .visitor-counter {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    color: var(--white);
    opacity: 0.35;
  }

  .visitor-counter span {
    font-weight: 600;
    color: var(--pink);
    opacity: 1;
  }

  .footer-bottom-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .footer-ssm {
    font-size: 0.68rem;
    opacity: 0.3;
    letter-spacing: 0.03em;
  }

  .footer-tagline {
    font-family: 'Roca', sans-serif;
    font-size: 0.85rem !important;
    opacity: 0.25 !important;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
