<section class="cta" id="shop">
  <div class="container cta-inner">

    <div class="cta-content reveal">
      <p class="cta-label">Ready?</p>
      <h2>Start Your<br /><span class="text-outline">Glow Journey</span></h2>
      <p class="cta-desc">Get your Glow Drop today and experience the difference. Free shipping on your first order.</p>
      <div class="cta-actions">
        <a href="https://shopee.com.my" class="btn btn-cta" target="_blank" rel="noopener">
          <span>Shop on Shopee</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <a href="https://instagram.com/rareblee" class="btn btn-follow" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          <span>Follow @rareblee</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 140px 0;
    background: linear-gradient(160deg, var(--pink) 0%, #f0b8c5 40%, var(--pink-light) 100%);
    position: relative;
    overflow: hidden;
  }


  .cta-inner {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--green);
    opacity: 0.5;
    margin-bottom: 16px;
  }

  .cta-content h2 {
    font-size: 4rem;
    color: var(--green);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .text-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--green);
    paint-order: stroke fill;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--green);
    opacity: 0.7;
    max-width: 420px;
    margin: 0 auto 44px;
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 36px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.4s var(--ease-out-expo);
  }

  .btn svg {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .btn-cta {
    background: var(--green);
    color: var(--white);
    box-shadow: 0 4px 24px rgba(27, 61, 47, 0.2), 0 1px 4px rgba(27, 61, 47, 0.1);
  }

  .btn-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(27, 61, 47, 0.25);
  }

  .btn-cta:hover svg {
    transform: translate(3px, -3px);
  }

  .btn-follow {
    background: rgba(255, 255, 255, 0.6);
    color: var(--green);
    backdrop-filter: blur(10px);
    border: 1.5px solid rgba(27, 61, 47, 0.12);
  }

  .btn-follow:hover {
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .cta {
      padding: 100px 0;
    }

    .cta-content h2 {
      font-size: 2.8rem;
    }
  }
</style>
