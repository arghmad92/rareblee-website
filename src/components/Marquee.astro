  <div class="marquee-track">
    <div class="marquee-content">
      <span class="marquee-item">Glow Drop</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Body Filter</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Pink Bloom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Natural</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Green Bliss</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Skin Safe</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Deodorant</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Cruelty Free</span>
      <span class="marquee-dot"></span>
      <!-- duplicate for seamless loop -->
      <span class="marquee-item">Glow Drop</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Body Filter</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Pink Bloom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item outline">Natural</span>
