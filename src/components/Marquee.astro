      <span class="marquee-dot"></span>
    </div>
  </div>
</div>

<style>
  .marquee-section {
    background: var(--green);
    padding: 20px 0;
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: marqueeScroll 30s linear infinite;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .marquee-item {
    font-family: 'Roca', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--pink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .marquee-item.outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--pink);
  }

  .marquee-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pink);
    opacity: 0.4;
    flex-shrink: 0;
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
